# =============================================================================
# Root .gitignore — applies to the whole monorepo
# Each sub-app (client/, client-next/, server/) has its own .gitignore too
# =============================================================================

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.code-workspace

# Env / secrets — never commit
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
**/node_modules/
**/.next/
**/dist/
**/build/
**/out/
**/coverage/

# Laravel-specific (mirrored from server/.gitignore for safety)
server/vendor/
server/storage/app/uploads/
server/storage/logs/
server/.phpunit.result.cache
server/bootstrap/cache/*.php

# Test / debug artefacts
.playwright-mcp/
playwright-report/
test-results/
live-*.png
screenshot-*.png
*.tsbuildinfo

# Cloudinary backup
cloudinary-backup/
