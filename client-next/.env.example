# =============================================================================
# client-next — Next.js storefront for Order-Management-System
# Copy to .env.local for local development:
#   cp .env.example .env.local
# =============================================================================

# Currency symbol shown in the UI
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Public API base path. In dev the Next.js server proxies `/backend/*`
# to the Laravel API (see next.config.mjs rewrites), so leave this as `/backend`.
NEXT_PUBLIC_API_URL=/backend

# Laravel backend URL (used by Next.js server-side rewrites only)
API_URL=http://localhost:8000

# Used by the Laravel Sanctum CSRF cookie flow if the storefront authenticates
# customers directly (rather than via a token issued from a server route).
# Leave commented unless you wire up SPA cookie auth.
# NEXT_PUBLIC_SANCTUM_URL=http://localhost:8000
